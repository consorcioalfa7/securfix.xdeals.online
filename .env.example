# ─── Securfix.xdeals.online — Environment Variables ─────────────────────────
# Copy this file to .env.local and fill in the values for your deployment.
# NEVER commit .env.local to version control.
#
# Usage: cp .env.example .env.local

# ─── XPayments Gateway (PRIMARY — server-side only) ─────────────────────────
# Required. Your XPayments live secret key. Used by /api/xpayments/checkout to
# create checkout sessions. NEVER prefix with NEXT_PUBLIC_ and NEVER expose to the client.
# Obtain from: https://xpayments.digital dashboard
XPAYMENTS_SECRET_KEY=<replace-with-your-xpayments-secret-key>

# Required. Your XPayments Store ID (UUID).
XPAYMENTS_STORE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional. HMAC signing secret for verifying incoming webhooks at
# /api/webhooks/xpayments. When set, the webhook validates the
# x-xpayments-signature header (HMAC-SHA256 of the raw body).
# Leave empty only for initial testing — always set in production.
XPAYMENTS_WEBHOOK_SECRET=

# ─── NeXFlowX Payment Gateway (legacy) ──────────────────────────────────────
# Required. Your NeXFlowX production API key for creating payment links.
# Obtain from: https://nexflowx.tech/dashboard
# Example: nx_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXFLOWX_API_KEY=nxf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Override the default NeXFlowX checkout base URL.
# Default: https://checkout.nexflowx.tech
NEXFLOWX_CHECKOUT_URL=https://checkout.nexflowx.tech

# Required. Webhook secret for verifying incoming webhook signatures (HMAC SHA256).
# This is used to validate that webhooks are genuinely from NeXFlowX.
# HMAC-SHA256(raw_body, this_secret) must match the x-nexflowx-signature header.
NEXFLOWX_WEBHOOK_SECRET=nx_sec_1c95daa585a6437dd71c7b38a94225ba

# Legacy alias (fallback if NEXFLOWX_WEBHOOK_SECRET is not set)
WEBHOOK_SECRET=nx_sec_1c95daa585a6437dd71c7b38a94225ba

# ─── Application ────────────────────────────────────────────────────────────
# Public base URL of the deployed application. Used for redirect URLs after payment.
# IMPORTANT: Set this to your Vercel deployment URL or custom domain.
# Example: https://securfix.xdeals.online
NEXT_PUBLIC_BASE_URL=https://securfix.xdeals.online

# ─── Database (Prisma / SQLite) ─────────────────────────────────────────────
# Local development uses file-based SQLite. For Vercel, use a persistent
# database or external storage (see technical document for details).
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ─── AI Chat (z-ai-web-dev-sdk) ─────────────────────────────────────────────
# The AI chat uses z-ai-web-dev-sdk which is pre-configured.
# No additional API key is needed for the built-in LLM integration.

# ─── OpenRouter (Optional — for mini-service chat) ─────────────────────────
# If using the mini-services/chat-service Socket.IO server instead of
# the built-in /api/chat endpoint, set your OpenRouter API key:
# OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Vercel Specific ────────────────────────────────────────────────────────
# These are set automatically by Vercel:
# VERCEL_URL
# VERCEL_ENV
# NODE_ENV=production
